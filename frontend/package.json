{
  "name": "myblog-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests build vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests build vite.config.ts playwright.config.ts",
    "images:optimize": "node build/optimize-images.mjs",
    "predev": "npm run images:optimize",
    "prebuild": "npm run images:optimize",
    "build:prerender": "npm run build && node build/prerender.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
