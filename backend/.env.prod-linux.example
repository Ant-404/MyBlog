# Copy to .env.prod-linux; Java properties syntax, no shell quotes or export.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=MyBlog
DB_USERNAME=myblog
DB_PASSWORD=replace-with-your-password
SERVER_PORT=8080
UPLOAD_DIRECTORY=/srv/myblog/uploads
MUSIC_SOURCE_DIRECTORY=/srv/myblog/frontend/public/music
# MUSIC_DIRECTORY=/srv/myblog/uploads/music
ADMIN_USERNAME=hanant
# Only needed to initialize an empty admin_users table.
ADMIN_PASSWORD=
# Defaults assume HTTPS through a trusted local reverse proxy.
SESSION_COOKIE_SECURE=true
FORWARD_HEADERS_STRATEGY=native
