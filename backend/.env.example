DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=MyBlog
DB_USERNAME=root
DB_PASSWORD=replace-with-your-password
SERVER_PORT=8080
# Set true only after importing database/MyBlog.sql (baseline includes V1 and V2).
FLYWAY_BASELINE_ON_MIGRATE=false

# Initialize the first admin only when admin_users is empty. Not a database password.
ADMIN_USERNAME=hanant
ADMIN_PASSWORD=
# Set true when deploying behind HTTPS.
SESSION_COOKIE_SECURE=false
# Use an absolute path so IDEA and packaged startup share the same image directory.
# UPLOAD_DIRECTORY=D:/MyBlog/uploads
# Set native only behind a trusted reverse proxy; otherwise keep none.
FORWARD_HEADERS_STRATEGY=none
