DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=MyBlog
DB_USERNAME=root
DB_PASSWORD=replace-with-your-password
SERVER_PORT=8080

# Initialize the first admin only when admin_users is empty. Not a database password.
ADMIN_USERNAME=hanant
ADMIN_PASSWORD=
# Set true when deploying behind HTTPS.
SESSION_COOKIE_SECURE=false
# Use an absolute path so IDEA and packaged startup share the same image directory.
# UPLOAD_DIRECTORY=D:/MyBlog/uploads
# Set native only behind a trusted reverse proxy; otherwise keep none.
FORWARD_HEADERS_STRATEGY=none

# Public QQ playlist resolver (Meting-compatible). Optional; no QQ password/cookie required.
METING_API_URL=https://api.i-meto.com/meting/api

# QQ SMTP: enable the SMTP service in QQ Mail and use its authorization code (not QQ password).
# Keep disabled until SMTP_USERNAME / SMTP_PASSWORD and the site's public URL are configured.
MEMBER_MAIL_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_AUTH=true
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional; defaults to SMTP_USERNAME. Must be an address allowed by the SMTP provider.
# SMTP_FROM=
